# See README.md > "Connect Google and YouTube" for exactly how to obtain each
# value below (which Google Cloud Console screen, what to restrict it to).
# Public client configuration. Never put a YouTube key here.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_DEMO=true
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
# Server only
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
MUSIKA_ORIGINS=http://localhost:8081
# Set to "production" to require secure (HTTPS-only) session cookies.
ENVIRONMENT=
# Only explicitly authorized video IDs may be downloaded. This is a fixed
# seed list; prefer managing the catalog live via the /admin/authorized-videos
# endpoints below once at least one admin email is configured.
AUTHORIZED_VIDEO_IDS=
# Comma-separated Google account emails allowed to call /admin/authorized-videos
# (list, add, remove) without redeploying the server.
ADMIN_EMAILS=
# Optional executable overrides. Blank uses the installed Python packages.
YT_DLP_PATH=
FFMPEG_PATH=
# Set after running `npx eas login` and `npx eas init` (see README).
EAS_PROJECT_ID=
