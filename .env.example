# See README.md > "Connect Google and YouTube" for exactly how to obtain each
# value below (which Google Cloud Console screen, what to restrict it to).
# Public client configuration only. Never put a YouTube key or other
# server-only secret here -- those belong in server/.env.example instead.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_DEMO=true
# Firebase console > Project settings > General > Your apps > Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Native (Android/iOS) only: the "Web client (auto created by Google Service)"
# OAuth client ID that Firebase made when you enabled the Google provider.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
# Set after running `npx eas login` and `npx eas init` (see README).
EAS_PROJECT_ID=

# Cloudflare Tunnel token for `docker compose --profile tunnel up -d`
# (see docs/cloudflare-tunnel.md). Never commit the real value.
TUNNEL_TOKEN=
