# See ../README.md > "Connect Google and YouTube" for exactly how to obtain
# each value below (which Google Cloud Console screen, what to restrict it to).
# This file is loaded by server/main.py directly -- never put a client-side
# EXPO_PUBLIC_* value here; those belong in the root .env instead.
YOUTUBE_API_KEY=
# Firebase project ID -- sign-in tokens are only accepted from this project.
FIREBASE_PROJECT_ID=
# Expo web dev server and the Electron desktop app (http://localhost:17321).
MUSIKA_ORIGINS=http://localhost:8081,http://localhost:17321
# Set to "production" to require secure (HTTPS-only) session cookies.
ENVIRONMENT=
# "none" when the web app and API are on different sites (e.g. Vercel + Render).
COOKIE_SAMESITE=lax
# Signs the short-lived /stream URLs the player uses. Blank picks a random key
# per process, so links in use break when the server restarts.
STREAM_SECRET=
# Optional executable overrides. Blank uses the installed Python packages.
YT_DLP_PATH=
FFMPEG_PATH=
# ---- yt-dlp (YouTube extraction). All optional; see docs/deployment.md. ----
# Only if YouTube answers this server with "Sign in to confirm you're not a
# bot" (common on cloud hosts). Path to a Netscape-format cookies.txt exported
# from a signed-in browser -- use a throwaway Google account, not your own.
YT_DLP_COOKIES_FILE=
# The same file's contents, base64-encoded, for hosts without secret files
# (Railway). Generate with: base64 -w0 cookies.txt
YT_DLP_COOKIES_B64=
# Or route yt-dlp through a (residential) proxy, e.g. http://user:pass@host:port.
YT_DLP_PROXY=
# PO Token provider server (bgutil-ytdlp-pot-provider), e.g. http://pot-provider:4416.
YT_DLP_POT_PROVIDER_URL=
# Raw --extractor-args, e.g. youtube:player_client=default,mweb
YT_DLP_EXTRACTOR_ARGS=
# Seconds yt-dlp waits between its own requests during extraction (0 = off).
YT_DLP_SLEEP_REQUESTS=0
# Throttling and retries.
YT_DLP_MAX_CONCURRENCY=4
YT_DLP_MIN_INTERVAL=1
YT_DLP_MAX_ATTEMPTS=3
YT_DLP_BACKOFF_SECONDS=2
YT_DLP_TIMEOUT=60
YT_DLP_SOCKET_TIMEOUT=30
# After a bot check or rate limit, fail fast for this many seconds instead of
# retrying. Changing cookies/proxy/PO token settings lifts it immediately.
YT_DLP_BLOCK_COOLDOWN=600
LOG_LEVEL=INFO
