{
  "name": "musika",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.cjs",
    "export": "expo export --platform web",
    "format": "prettier --write App.tsx src",
    "build:android": "eas build --platform android --profile preview",
    "build:android:dev": "eas build --platform android --profile development",
    "desktop": "cd electron && npm install && npm start",
    "desktop:build": "npm run export && cd electron && npm install && npm run dist"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.19.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eas-cli": "^16.6.1",
    "prettier": "^3.9.9",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  }
}
